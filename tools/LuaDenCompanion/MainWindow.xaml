<Window x:Class="LuaDenCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LuaDen Companion" Height="760" Width="1120"
        MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="PS5 LAN address"/>
                    <TextBox x:Name="HostBox" Text="192.168.1.100"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="Port"/>
                    <TextBox x:Name="PortBox" Text="8080"/>
                </StackPanel>
                <Button Grid.Column="2" Margin="10,20,3,3" Content="Connect" Click="Connect_Click"/>
                <Button Grid.Column="3" Margin="3,20,3,3" Content="Start pairing" Click="StartPairing_Click"/>
                <StackPanel Grid.Column="4" Margin="8,0,0,0" Width="95">
                    <TextBlock FontWeight="SemiBold" Text="TV code"/>
                    <TextBox x:Name="PairCodeBox" MaxLength="6"/>
                </StackPanel>
                <Button Grid.Column="5" Margin="3,20,3,3" Content="Pair" Click="Pair_Click"/>
            </Grid>
        </Border>

        <TextBlock x:Name="HelpText" Grid.Row="1" Margin="4,9,4,12" Foreground="#4B5563"
                   Text="Connect to Playden on the same trusted LAN. Pairing credentials remain in memory only."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Playden games" Margin="0,0,8,0">
                <DockPanel Margin="6">
                    <Button DockPanel.Dock="Bottom" Content="Refresh games" Click="RefreshGames_Click"/>
                    <ListBox x:Name="GamesList" DisplayMemberPath="Display"
                             SelectionChanged="GamesList_SelectionChanged"/>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Game folders" Margin="0,0,8,0">
                <DockPanel Margin="6">
                    <Button DockPanel.Dock="Bottom" Content="Open selected folder" Click="OpenRoot_Click"/>
                    <ListBox x:Name="RootsList" DisplayMemberPath="Display"/>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Files">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock x:Name="PathLabel" VerticalAlignment="Center" Text="/"/>
                            <Button DockPanel.Dock="Right" Content="Up" Click="Up_Click" MinWidth="55"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Import .lua manifest profile" Click="ImportProfile_Click"/>
                            <Button Content="Download selected file" Click="Download_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <ListView x:Name="FilesList" MouseDoubleClick="FilesList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="280" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type" Width="65" DisplayMemberBinding="{Binding TypeLabel}"/>
                                <GridViewColumn Header="Size" Width="115" DisplayMemberBinding="{Binding SizeLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="9" Background="#F3F4F6" CornerRadius="6">
            <TextBlock x:Name="StatusText" Text="Not connected." TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
